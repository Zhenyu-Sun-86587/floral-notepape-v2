+// macOS-only local experiment. Reuse registrations and never delete profiles/devices.
+struct DSCertificatesFolioProfilesCommand: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(commandName: "folio-profiles", abstract: "Request macOS development profiles for Folio on one Mac")
+    @Argument var udid: String
+    @Argument var output: String
+    func run() async throws {
+        let client = DeveloperAPIClient(auth: try AuthToken.saved().authData())
+        var devices = try await client.devicesGetCollection().ok.body.json.data
+        if !devices.contains(where: { $0.attributes?.udid == udid }) {
+            let response = try await client.devicesCreateInstance(body: .json(.init(data: .init(_type: .devices, attributes: .init(name: "Folio Mac test", platform: .init(.macOs), udid: udid)))))
+            devices.append(try response.created.body.json.data)
+        }
+        guard let device = devices.first(where: { $0.attributes?.udid == udid }) else { throw Console.Error("Mac device registration missing") }
+        let certificates = try await client.certificatesGetCollection().ok.body.json.data
+        guard certificates.count == 1 else { throw Console.Error("Expected exactly the one test certificate; refusing ambiguous selection") }
+        let directory = URL(fileURLWithPath: output, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+        for identifier in ["dev.hermes.surface", "dev.hermes.surface.widgets"] {
+            var bundleIDs = try await client.bundleIdsGetCollection(query: .init(filter_lbrack_identifier_rbrack_: [identifier])).ok.body.json.data
+            if !bundleIDs.contains(where: { $0.attributes?.identifier == identifier }) {
+                let response = try await client.bundleIdsCreateInstance(body: .json(.init(data: .init(_type: .bundleIds, attributes: .init(name: identifier == "dev.hermes.surface" ? "Folio" : "Folio Widgets", platform: .init(.macOs), identifier: identifier)))))
+                bundleIDs.append(try response.created.body.json.data)
+            }
+            guard let bundle = bundleIDs.first(where: { $0.attributes?.identifier == identifier }) else { throw Console.Error("Bundle registration missing") }
+            let capabilities = try await client.bundleIdsBundleIdCapabilitiesGetToManyRelated(.init(path: .init(id: bundle.id))).ok.body.json.data
+            if !capabilities.contains(where: { $0.attributes?.capabilityType?.value1 == .appGroups }) {
+                let response = try await client.bundleIdCapabilitiesCreateInstance(body: .json(.init(data: .init(_type: .bundleIdCapabilities, attributes: .init(capabilityType: .init(.appGroups)), relationships: .init(bundleId: .init(data: .init(_type: .bundleIds, id: bundle.id)), capability: .init(data: .init(_type: .capabilities, id: .init(.appGroups))))))))
+                _ = try response.created
+            }
+            let response = try await client.profilesCreateInstance(body: .json(.init(data: .init(_type: .profiles, attributes: .init(name: "Folio Mac test " + identifier + " " + UUID().uuidString, profileType: .init(.macAppDevelopment)), relationships: .init(bundleId: .init(data: .init(_type: .bundleIds, id: bundle.id)), devices: .init(data: [.init(_type: .devices, id: device.id)]), certificates: .init(data: [.init(_type: .certificates, id: certificates[0].id)]))))))
+            guard let content = try response.created.body.json.data.attributes?.profileContent, let data = Data(base64Encoded: content) else { throw Console.Error("No profile in response") }
+            let path = directory.appendingPathComponent(identifier + ".provisionprofile")
+            try data.write(to: path, options: .atomic)
+            try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: path.path)
+            print("Saved macOS development profile for " + identifier)
+        }
+    }
+}
