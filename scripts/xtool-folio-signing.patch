+// Local experiment only. Never revoke existing certificates.
+struct DSCertificatesFolioCreateCommand: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(commandName: "folio-create", abstract: "Create one development certificate without revocation")
+    @Argument var output: String
+
+    func run() async throws {
+        let auth = try AuthToken.saved().authData()
+        let client = DeveloperAPIClient(auth: auth)
+        let existing = try await client.certificatesGetCollection().ok.body.json.data
+        guard existing.isEmpty else {
+            throw Console.Error("Existing certificates found; refusing to create or revoke anything.")
+        }
+        let directory = URL(fileURLWithPath: output, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+        let keypair = try Keypair()
+        let key = try keypair.privateKey()
+        let keyPath = directory.appendingPathComponent("development.key")
+        guard !FileManager.default.fileExists(atPath: keyPath.path) else {
+            throw Console.Error("Key already exists; refusing to overwrite.")
+        }
+        // Persist the key before the server request, so a lost response does not lose it.
+        try key.data.write(to: keyPath, options: .atomic)
+        try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: keyPath.path)
+        let csr = try keypair.generateCSR()
+        let response = try await client.certificatesCreateInstance(body: .json(.init(data: .init(_type: .certificates, attributes: .init(csrContent: csr.pemString, certificateType: .init(.development))))))
+        guard let content = try response.created.body.json.data.attributes?.certificateContent,
+              let data = Data(base64Encoded: content) else {
+            throw Console.Error("No certificate in server response; retain the key for recovery.")
+        }
+        try data.write(to: directory.appendingPathComponent("development.cer"), options: .atomic)
+        let certificate = try Certificate(data: data)
+        print("Certificate created: \(try certificate.developerIdentity())")
+        print("Team: \(try certificate.teamID())")
+        print("Saved in protected local directory; no private key printed.")
+    }
+}
